configfile: "config/config.yaml"

SAMPLES = config["samples"]
RAW_DIR = config["raw_dir"]
GENOME = config["ref"]["genome"]
GTF = config["ref"]["gtf"]
TRANSCRIPTS = config["ref"]["transcripts"]
THREADS = config["threads"]

rule all:
    input:
        expand("results/qc/raw/{sample}_{read}_fastqc.html", sample=SAMPLES, read=[1, 2]),
        expand("results/qc/trimmed/{sample}_{read}.trimmed_fastqc.html", sample=SAMPLES, read=[1, 2]),
        "results/counts/featurecounts.txt",
        expand("results/kallisto/{sample}/abundance.tsv", sample=SAMPLES),
        expand("results/qc/align/rseqc/{sample}.bam_stat.txt", sample=SAMPLES),
        expand("results/qc/align/rseqc/{sample}.infer_experiment.txt", sample=SAMPLES),
        expand("results/qc/align/rseqc/{sample}.read_distribution.txt", sample=SAMPLES),
        expand("results/qc/align/rseqc/{sample}.inner_distance_freq.txt", sample=SAMPLES),
        "results/qc/align/rseqc/genebody.geneBodyCoverage.txt",
        "results/qc/align/deeptools/correlation_heatmap.png",
        "results/qc/align/deeptools/pca.png"

# Read preprocessing

rule fastqc_raw:
    input:
        r1 = f"{RAW_DIR}/{{sample}}_1.fastq.gz",
        r2 = f"{RAW_DIR}/{{sample}}_2.fastq.gz"
    output:
        html1 = "results/qc/raw/{sample}_1_fastqc.html",
        zip1  = "results/qc/raw/{sample}_1_fastqc.zip",
        html2 = "results/qc/raw/{sample}_2_fastqc.html",
        zip2  = "results/qc/raw/{sample}_2_fastqc.zip"
    threads: 2
    conda: "envs/qc.yaml"
    log: "logs/fastqc_raw/{sample}.log"
    shell:
        "fastqc -t {threads} --outdir results/qc/raw {input.r1} {input.r2} &> {log}"

rule fastp:
    input:
        r1 = f"{RAW_DIR}/{{sample}}_1.fastq.gz",
        r2 = f"{RAW_DIR}/{{sample}}_2.fastq.gz"
    output:
        r1   = "results/trimmed/{sample}_1.trimmed.fastq.gz",
        r2   = "results/trimmed/{sample}_2.trimmed.fastq.gz",
        json = "results/qc/fastp/{sample}.fastp.json",
        html = "results/qc/fastp/{sample}.fastp.html"
    threads: THREADS
    conda: "envs/qc.yaml"
    log: "logs/fastp/{sample}.log"
    shell:
        """
        fastp -i {input.r1} -I {input.r2} \
              -o {output.r1} -O {output.r2} \
              --detect_adapter_for_pe \
              --thread {threads} \
              --json {output.json} --html {output.html} &> {log}
        """

rule fastqc_trimmed:
    input:
        r1 = "results/trimmed/{sample}_1.trimmed.fastq.gz",
        r2 = "results/trimmed/{sample}_2.trimmed.fastq.gz"
    output:
        html1 = "results/qc/trimmed/{sample}_1.trimmed_fastqc.html",
        zip1  = "results/qc/trimmed/{sample}_1.trimmed_fastqc.zip",
        html2 = "results/qc/trimmed/{sample}_2.trimmed_fastqc.html",
        zip2  = "results/qc/trimmed/{sample}_2.trimmed_fastqc.zip"
    threads: 2
    conda: "envs/qc.yaml"
    log: "logs/fastqc_trimmed/{sample}.log"
    shell:
        "fastqc -t {threads} --outdir results/qc/trimmed {input.r1} {input.r2} &> {log}"

# Alignment-based quantification

rule hisat2_index:
    input:
        genome = GENOME
    output:
        multiext("results/index/hisat2/genome", ".1.ht2", ".2.ht2", ".3.ht2", ".4.ht2", ".5.ht2", ".6.ht2", ".7.ht2", ".8.ht2")
    params:
        prefix = "results/index/hisat2/genome"
    threads: THREADS
    conda: "envs/align.yaml"
    log: "logs/hisat2/index.log"
    shell:
        "hisat2-build -p {threads} {input.genome} {params.prefix} &> {log}"

rule hisat2_align:
    input:
        r1 = "results/trimmed/{sample}_1.trimmed.fastq.gz",
        r2 = "results/trimmed/{sample}_2.trimmed.fastq.gz",
        idx = rules.hisat2_index.output
    output:
        bam = "results/aligned/{sample}.sorted.bam",
        bai = "results/aligned/{sample}.sorted.bam.bai",
        summary = "results/aligned/{sample}.hisat2_summary.txt"
    params:
        prefix = "results/index/hisat2/genome"
    threads: THREADS
    conda: "envs/align.yaml"
    log: "logs/hisat2/{sample}.log"
    shell:
        """
        hisat2 -p {threads} -x {params.prefix} \
               -1 {input.r1} -2 {input.r2} \
               --new-summary --summary-file {output.summary} 2> {log} \
        | samtools sort -@ {threads} -o {output.bam} - 2>> {log}
        samtools index {output.bam} 2>> {log}
        """

rule featurecounts:
    input:
        bams = expand("results/aligned/{sample}.sorted.bam", sample=SAMPLES),
        gtf  = GTF
    output:
        counts  = "results/counts/featurecounts.txt",
        summary = "results/counts/featurecounts.txt.summary"
    threads: THREADS
    conda: "envs/align.yaml"
    log: "logs/featurecounts/featurecounts.log"
    shell:
        """
        featureCounts -T {threads} -p --countReadPairs -B -C \
                      -a {input.gtf} -o {output.counts} {input.bams} &> {log}
        """

# Alignment-free quantification

rule kallisto_index:
    input:
        transcripts = TRANSCRIPTS
    output:
        idx = "results/index/kallisto/transcripts.idx"
    conda: "envs/kallisto.yaml"
    log: "logs/kallisto/index.log"
    shell:
        "kallisto index -i {output.idx} {input.transcripts} &> {log}"

rule kallisto_quant:
    input:
        r1  = "results/trimmed/{sample}_1.trimmed.fastq.gz",
        r2  = "results/trimmed/{sample}_2.trimmed.fastq.gz",
        idx = rules.kallisto_index.output.idx
    output:
        tsv  = "results/kallisto/{sample}/abundance.tsv",
        h5   = "results/kallisto/{sample}/abundance.h5",
        json = "results/kallisto/{sample}/run_info.json"
    params:
        outdir = "results/kallisto/{sample}"
    threads: THREADS
    conda: "envs/kallisto.yaml"
    log: "logs/kallisto/{sample}.log"
    shell:
        "kallisto quant -i {input.idx} -o {params.outdir} -t {threads} {input.r1} {input.r2} &> {log}"

# Alignment quality assessment

rule gtf_to_bed:
    input:
        gtf = GTF
    output:
        bed      = "results/qc/align/genes.bed",
        mane_bed = "results/qc/align/genes_mane.bed"
    conda: "envs/align_qc.yaml"
    log: "logs/align_qc/gtf_to_bed.log"
    shell:
        """
        gtfToGenePred {input.gtf} results/qc/align/genes.genePred 2> {log}
        genePredToBed results/qc/align/genes.genePred {output.bed} 2>> {log}
        grep 'tag "MANE_Select"' {input.gtf} > results/qc/align/mane.gtf
        gtfToGenePred results/qc/align/mane.gtf results/qc/align/mane.genePred 2>> {log}
        genePredToBed results/qc/align/mane.genePred {output.mane_bed} 2>> {log}
        rm -f results/qc/align/genes.genePred results/qc/align/mane.gtf results/qc/align/mane.genePred
        """

rule rseqc_sample:
    input:
        bam = "results/aligned/{sample}.sorted.bam",
        bai = "results/aligned/{sample}.sorted.bam.bai",
        bed = rules.gtf_to_bed.output.bed
    output:
        bam_stat   = "results/qc/align/rseqc/{sample}.bam_stat.txt",
        infer_exp  = "results/qc/align/rseqc/{sample}.infer_experiment.txt",
        read_dist  = "results/qc/align/rseqc/{sample}.read_distribution.txt",
        inner_dist = "results/qc/align/rseqc/{sample}.inner_distance_freq.txt"
    params:
        inner_prefix = "results/qc/align/rseqc/{sample}"
    conda: "envs/align_qc.yaml"
    log: "logs/align_qc/rseqc_{sample}.log"
    shell:
        """
        bam_stat.py -i {input.bam} > {output.bam_stat} 2> {log}
        infer_experiment.py -r {input.bed} -i {input.bam} > {output.infer_exp} 2>> {log}
        read_distribution.py -r {input.bed} -i {input.bam} > {output.read_dist} 2>> {log}
        inner_distance.py -r {input.bed} -i {input.bam} -o {params.inner_prefix} >> {log} 2>&1
        """

rule rseqc_genebody:
    input:
        bams     = expand("results/aligned/{sample}.sorted.bam", sample=SAMPLES),
        bais     = expand("results/aligned/{sample}.sorted.bam.bai", sample=SAMPLES),
        mane_bed = rules.gtf_to_bed.output.mane_bed
    output:
        txt = "results/qc/align/rseqc/genebody.geneBodyCoverage.txt"
    params:
        prefix = "results/qc/align/rseqc/genebody"
    conda: "envs/align_qc.yaml"
    log: "logs/align_qc/genebody.log"
    shell:
        """
        BAMS=$(echo {input.bams} | tr ' ' ',')
        geneBody_coverage.py -r {input.mane_bed} -i $BAMS -o {params.prefix} &> {log}
        """

rule deeptools_summary:
    input:
        bams = expand("results/aligned/{sample}.sorted.bam", sample=SAMPLES),
        bais = expand("results/aligned/{sample}.sorted.bam.bai", sample=SAMPLES)
    output:
        npz = "results/qc/align/deeptools/bam_summary.npz"
    params:
        labels = " ".join(SAMPLES)
    threads: THREADS
    conda: "envs/align_qc.yaml"
    log: "logs/align_qc/deeptools_summary.log"
    shell:
        "multiBamSummary bins --bamfiles {input.bams} --labels {params.labels} -p {threads} -o {output.npz} &> {log}"

rule deeptools_plots:
    input:
        npz = rules.deeptools_summary.output.npz
    output:
        corr     = "results/qc/align/deeptools/correlation_heatmap.png",
        corr_tab = "results/qc/align/deeptools/correlation_matrix.tab",
        pca      = "results/qc/align/deeptools/pca.png",
        pca_tab  = "results/qc/align/deeptools/pca_data.tab"
    conda: "envs/align_qc.yaml"
    log: "logs/align_qc/deeptools_plots.log"
    shell:
        """
        plotCorrelation -in {input.npz} --corMethod pearson --whatToPlot heatmap --plotNumbers -o {output.corr} --outFileCorMatrix {output.corr_tab} &> {log}
        plotPCA -in {input.npz} -o {output.pca} --outFileNameData {output.pca_tab} &>> {log}
        """
