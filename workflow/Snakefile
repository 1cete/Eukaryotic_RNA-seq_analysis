configfile: "config/config.yaml"

SAMPLES = config["samples"]
RAW_DIR = config["raw_dir"]
GENOME = config["ref"]["genome"]
GTF = config["ref"]["gtf"]
THREADS = config["threads"]

rule all:
    input:
        expand("results/qc/raw/{sample}_{read}_fastqc.html", sample=SAMPLES, read=[1, 2]),
        expand("results/qc/trimmed/{sample}_{read}.trimmed_fastqc.html", sample=SAMPLES, read=[1, 2]),
        "results/counts/featurecounts.txt"

# --- 2.1 Read preprocessing ---

rule fastqc_raw:
    input:
        r1 = f"{RAW_DIR}/{{sample}}_1.fastq.gz",
        r2 = f"{RAW_DIR}/{{sample}}_2.fastq.gz"
    output:
        html1 = "results/qc/raw/{sample}_1_fastqc.html",
        zip1  = "results/qc/raw/{sample}_1_fastqc.zip",
        html2 = "results/qc/raw/{sample}_2_fastqc.html",
        zip2  = "results/qc/raw/{sample}_2_fastqc.zip"
    threads: 2
    conda: "envs/qc.yaml"
    log: "logs/fastqc_raw/{sample}.log"
    shell:
        "fastqc -t {threads} --outdir results/qc/raw {input.r1} {input.r2} &> {log}"

rule fastp:
    input:
        r1 = f"{RAW_DIR}/{{sample}}_1.fastq.gz",
        r2 = f"{RAW_DIR}/{{sample}}_2.fastq.gz"
    output:
        r1   = "results/trimmed/{sample}_1.trimmed.fastq.gz",
        r2   = "results/trimmed/{sample}_2.trimmed.fastq.gz",
        json = "results/qc/fastp/{sample}.fastp.json",
        html = "results/qc/fastp/{sample}.fastp.html"
    threads: THREADS
    conda: "envs/qc.yaml"
    log: "logs/fastp/{sample}.log"
    shell:
        """
        fastp -i {input.r1} -I {input.r2} \
              -o {output.r1} -O {output.r2} \
              --detect_adapter_for_pe \
              --thread {threads} \
              --json {output.json} --html {output.html} &> {log}
        """

rule fastqc_trimmed:
    input:
        r1 = "results/trimmed/{sample}_1.trimmed.fastq.gz",
        r2 = "results/trimmed/{sample}_2.trimmed.fastq.gz"
    output:
        html1 = "results/qc/trimmed/{sample}_1.trimmed_fastqc.html",
        zip1  = "results/qc/trimmed/{sample}_1.trimmed_fastqc.zip",
        html2 = "results/qc/trimmed/{sample}_2.trimmed_fastqc.html",
        zip2  = "results/qc/trimmed/{sample}_2.trimmed_fastqc.zip"
    threads: 2
    conda: "envs/qc.yaml"
    log: "logs/fastqc_trimmed/{sample}.log"
    shell:
        "fastqc -t {threads} --outdir results/qc/trimmed {input.r1} {input.r2} &> {log}"

# --- 2.2 Alignment-based quantification ---

rule hisat2_index:
    input:
        genome = GENOME
    output:
        multiext("results/index/hisat2/genome", ".1.ht2", ".2.ht2", ".3.ht2", ".4.ht2", ".5.ht2", ".6.ht2", ".7.ht2", ".8.ht2")
    params:
        prefix = "results/index/hisat2/genome"
    threads: THREADS
    conda: "envs/align.yaml"
    log: "logs/hisat2/index.log"
    shell:
        "hisat2-build -p {threads} {input.genome} {params.prefix} &> {log}"

rule hisat2_align:
    input:
        r1 = "results/trimmed/{sample}_1.trimmed.fastq.gz",
        r2 = "results/trimmed/{sample}_2.trimmed.fastq.gz",
        idx = rules.hisat2_index.output
    output:
        bam = "results/aligned/{sample}.sorted.bam",
        bai = "results/aligned/{sample}.sorted.bam.bai",
        summary = "results/aligned/{sample}.hisat2_summary.txt"
    params:
        prefix = "results/index/hisat2/genome"
    threads: THREADS
    conda: "envs/align.yaml"
    log: "logs/hisat2/{sample}.log"
    shell:
        """
        hisat2 -p {threads} -x {params.prefix} \
               -1 {input.r1} -2 {input.r2} \
               --new-summary --summary-file {output.summary} 2> {log} \
        | samtools sort -@ {threads} -o {output.bam} - 2>> {log}
        samtools index {output.bam} 2>> {log}
        """

rule featurecounts:
    input:
        bams = expand("results/aligned/{sample}.sorted.bam", sample=SAMPLES),
        gtf  = GTF
    output:
        counts  = "results/counts/featurecounts.txt",
        summary = "results/counts/featurecounts.txt.summary"
    threads: THREADS
    conda: "envs/align.yaml"
    log: "logs/featurecounts/featurecounts.log"
    shell:
        """
        featureCounts -T {threads} -p --countReadPairs -B -C \
                      -a {input.gtf} -o {output.counts} {input.bams} &> {log}
        """
